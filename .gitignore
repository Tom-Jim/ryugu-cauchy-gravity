# ---------------------------------------------------------------------------
# Rust / WebAssembly build output
# ---------------------------------------------------------------------------
/target/
/pkg/
/dist/
bakes/rtfp/target/
bakes/esa-build/
bakes/build/

# wgpu / shaderc scratch
*.spv

# ---------------------------------------------------------------------------
# Node / Bun
# ---------------------------------------------------------------------------
/node_modules/
bun.lockb
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Third-party checkouts and downloaded meshes
#
# `vendor/polyhedral-gravity-model` is the ESA reference library, fetched
# locally by `bun run esa:configure`; `assets/models/*.obj` are Hayabusa2 shape
# models that are far too large to version. The rendered GLB *is* tracked.
# ---------------------------------------------------------------------------
/vendor/
assets/models/*.obj

# ---------------------------------------------------------------------------
# Bake scratch state
#
# Solver output is a local, disposable scratch file. It is regenerated by a
# recompute and is never part of the browser bundle or the repository.
# ---------------------------------------------------------------------------
assets/records/

# ---------------------------------------------------------------------------
# Local, unpublished notes
#
# Measurement dumps handed to a reviewer or to another model, plus any
# scratch analysis, stay on the machine that produced them: the figures in the
# README are the published summary of these numbers.
# ---------------------------------------------------------------------------
*.local.md
/reports/

# ---------------------------------------------------------------------------
# Environment / editor / OS
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~
